MYSQL_USER=admin
MYSQL_PASSWORD=password
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=knowledge_center
DATABASE_URL=mysql+pymysql://admin:password@localhost:3306/knowledge_center?charset=utf8mb4
ENVIRONMENT=development
# Production must set a random value of at least 32 characters.
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
MAX_UPLOAD_SIZE_MB=50
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
# Optional MCP identity. Prefer MCP_API_KEY (kck_...) over MCP_AUTH_USER. Never fall back to admin.
# MCP_AUTH_USER=admin
# MCP_API_KEY=
